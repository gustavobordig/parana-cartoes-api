        <mxCell id="dbc" value="SQL Server&lt;br&gt;clientes_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="280" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="ex1" value="exchange&lt;br&gt;cliente-cadastrado" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="120" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="fila1" value="fila&lt;br&gt;proposta-cliente-&lt;br&gt;cadastrado" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.08;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="175" height="80" as="geometry" /></mxCell>
        <mxCell id="dlq1" value="DLQ&lt;br&gt;..._error" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.08;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="175" height="60" as="geometry" /></mxCell>
        <mxCell id="propostas" value="Propostas API" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="120" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="dbp" value="SQL Server&lt;br&gt;propostas_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1420" y="115" width="160" height="90" as="geometry" /></mxCell>
        <mxCell id="ex2" value="exchange&lt;br&gt;proposta-gerada" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="530" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="fila2" value="fila&lt;br&gt;cartao-proposta-&lt;br&gt;gerada" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.08;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="530" width="175" height="80" as="geometry" /></mxCell>
        <mxCell id="dlq2" value="DLQ&lt;br&gt;..._error" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.08;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="650" width="175" height="60" as="geometry" /></mxCell>
        <mxCell id="cartoes" value="Cartões API" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="530" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="mongo" value="MongoDB&lt;br&gt;cartoes_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="525" width="160" height="90" as="geometry" /></mxCell>
        <mxCell id="e0" value="POST /api/v1/clientes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="front" target="clientes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="cliente + outbox&lt;br&gt;(1 transação)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="clientes" target="dbc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="ClienteCadastrado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="clientes" target="ex1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ex1" target="fila1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="consome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="fila1" target="propostas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="falha após retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="fila1" target="dlq1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="propostas" target="dbp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="PropostaGerada&lt;br&gt;(outbox)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="propostas" target="ex2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ex2" target="fila2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="consome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="fila2" target="cartoes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="falha após retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="fila2" target="dlq2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="cartoes" target="mongo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Regra de score&lt;/b&gt;&lt;br&gt;score = min(1000, renda ÷ 10)&lt;br&gt;• 0 – 100: negada, sem cartão&lt;br&gt;• 101 – 500: 1 cartão de R$ 1.000&lt;br&gt;• 501 – 1000: 2 cartões de R$ 5.000" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="470" height="140" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Resiliência nos consumers&lt;/b&gt;&lt;br&gt;• Retry exponencial: 3 novas tentativas&lt;br&gt;• Erro de regra: direto para a DLQ, sem retry&lt;br&gt;• Kill switch: pausa se 15% das mensagens falham&lt;br&gt;• Idempotência: índice único / _id por proposta" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="780" width="520" height="140" as="geometry" /></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Consistência e rastreio&lt;/b&gt;&lt;br&gt;• Outbox: entidade e evento na mesma transação&lt;br&gt;• Inbox: deduplica reentregas do broker&lt;br&gt;• Correlation ID propagado pelos 3 serviços&lt;br&gt;• Front acompanha por GET (polling)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="780" width="490" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

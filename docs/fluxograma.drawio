        <mxCell id="titulo" value="Fluxo de concessão de crédito: 3 microsserviços via RabbitMQ" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="rmq1" value="RabbitMQ" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#b46504;fillColor=none;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="80" width="410" height="250" as="geometry" /></mxCell>
